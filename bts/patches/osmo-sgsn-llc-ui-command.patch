llc: send UI frames as commands with C/R=1 (3GPP TS 44.064 6.2.2, 6.4.2.1)

diff --git a/src/sgsn/gprs_llc.c b/src/sgsn/gprs_llc.c
index 82e876d2e..b878d96bc 100644
--- a/src/sgsn/gprs_llc.c
+++ b/src/sgsn/gprs_llc.c
@@ -796,10 +796,9 @@ int gprs_llc_tx_ui(struct msgb *msg, uint8_t sapi, int command,
 	if ((lle->vu_send + 1) / 512)
 		lle->oc_ui_send += 512;
 
-	/* Address Field */
-	addr = sapi & 0xf;
-	if (command)
-		addr |= 0x40;
+	/* Address Field: UI is always a command, SGSN sends commands with C/R=1
+	 * (3GPP TS 44.064 6.2.2, 6.4.2.1) */
+	addr = 0x40 | (sapi & 0xf);
 
 	/* Control Field */
 	ctrl[0] = 0xc0;
