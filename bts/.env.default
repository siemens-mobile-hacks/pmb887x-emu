# Defaults; override any of them in .env.

# Address and UDP port where emulators reach trxmux.
TRXMUX_ADDRESS=127.0.0.1
TRXMUX_PORT=5750

# Network operator: MCC 001 and MNC 01 are the ITU test network.
# The IMSI of a home SIM card starts with MCC and MNC.
OPERATOR_MCC=001
OPERATOR_MNC=01

# Number of cells, 1 to 10; every connected emulator gets its own cell.
BTS_CELLS=4

# GPRS authentication and GEA3 ciphering.
GPRS_CIPHERING=true

# Every new subscriber gets the key SIM_KI and the phone number MSISDN_PREFIX followed by
# the last 9 IMSI digits without leading zeros: IMSI 001010000001000 gets 1000.
SIM_KI=000102030405060708090A0B0C0D0E0F
MSISDN_PREFIX=

# Send the settings of config/provisioning.xml to every new subscriber by SMS.
PROVISION_SETTINGS=true
